{
  "name": "@kollors/deep-json-server",
  "version": "0.8.0",
  "description": "JSON mock server with deep filters and recursive relationship embedding",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "deep-json-server": "dist/bin/deep-json-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.ru.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.js && tsc && node scripts/prepare-dist.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pack:check": "node scripts/check-package.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run pack:check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "lowdb": "^7.0.1",
    "pluralize": "^8.0.0",
    "yaml": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kollors/deep-json-server.git"
  },
  "homepage": "https://github.com/kollors/deep-json-server",
  "bugs": {
    "url": "https://github.com/kollors/deep-json-server/issues"
  },
  "keywords": [
    "api",
    "crud",
    "deep-filter",
    "file-upload",
    "json",
    "json-server",
    "mock",
    "mock-api",
    "mock-server",
    "openapi",
    "relations",
    "rest",
    "rest-api"
  ],
  "author": "kollors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.10.0",
    "@types/pluralize": "^0.0.33",
    "typescript": "^7.0.2"
  }
}

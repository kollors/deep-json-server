{
  "name": "@kollors/deep-json-server",
  "version": "0.4.0",
  "description": "JSON mock server with deep filters and recursive relationship embedding",
  "type": "module",
  "types": "./types/index.d.ts",
  "bin": {
    "deep-json-server": "bin/deep-json-server.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "bin",
    "index.js",
    "src",
    "types",
    "LICENSE",
    "README.md",
    "README.ru.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check bin/deep-json-server.js && node --check src/*.js && node --check src/openapi/*.js && node --check src/query/*.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepack": "npm run types",
    "prepublishOnly": "npm run verify",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90",
    "types": "tsc -p tsconfig.types.json",
    "verify": "npm run check && npm run lint && npm run test:coverage && npm run types"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "lowdb": "^7.0.1",
    "pluralize": "^8.0.0",
    "yaml": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kollors/deep-json-server.git"
  },
  "homepage": "https://github.com/kollors/deep-json-server",
  "bugs": {
    "url": "https://github.com/kollors/deep-json-server/issues"
  },
  "keywords": [
    "api",
    "deep-filter",
    "json",
    "mock",
    "relations",
    "rest"
  ],
  "author": "kollors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "typescript": "^7.0.2"
  }
}

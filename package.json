{
  "name": "@kollors/deep-json-server",
  "version": "1.0.0-alpha.7",
  "description": "JSON mock server with schema-driven REST, GraphQL, nested queries and OpenAPI generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "deep-json-server": "dist/bin/deep-json-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/src/server/public.d.ts",
      "import": "./dist/src/server/public.js"
    },
    "./openapi": {
      "types": "./dist/src/openapi/entry.d.ts",
      "import": "./dist/src/openapi/entry.js"
    },
    "./graphql": {
      "types": "./dist/src/graphql/entry.d.ts",
      "import": "./dist/src/graphql/entry.js"
    },
    "./auth": {
      "types": "./dist/src/auth/public.d.ts",
      "import": "./dist/src/auth/public.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.ru.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.js && tsc && node scripts/prepare-dist.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pack:check": "node scripts/check-package.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && node scripts/run-coverage.js",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run pack:check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.3",
    "graphql": "^16.14.2",
    "lowdb": "^7.0.1",
    "mercurius": "^16.10.0",
    "pluralize": "^8.0.0",
    "yaml": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kollors/deep-json-server.git"
  },
  "homepage": "https://github.com/kollors/deep-json-server",
  "bugs": {
    "url": "https://github.com/kollors/deep-json-server/issues"
  },
  "keywords": [
    "api",
    "crud",
    "deep-filter",
    "file-upload",
    "json",
    "mock",
    "mock-api",
    "mock-server",
    "openapi",
    "relations",
    "rest",
    "rest-api",
    "graphql",
    "openapi-generator"
  ],
  "author": "kollors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.0.0",
    "@types/pluralize": "^0.0.33",
    "typescript": "^7.0.2"
  }
}

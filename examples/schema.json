{
  "api": ["rest", "graphql"],
  "models": {
    "Country": {
      "collection": "countries",
      "fields": {
        "id": {
          "type": "string",
          "primary": true,
          "generated": "uuid"
        },
        "isArchived": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "users": {
          "type": "User[]",
          "keyOn": "related"
        }
      }
    },
    "Genre": {
      "collection": "genres",
      "fields": {
        "id": {
          "type": "string",
          "primary": true,
          "generated": "uuid"
        },
        "isArchived": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "parentIds": {
          "type": "string[]"
        },
        "parents": {
          "type": "Genre[]",
          "keyOn": "current"
        },
        "children": {
          "type": "Genre[]",
          "keyOn": "related"
        },
        "movies": {
          "type": "Movie[]",
          "keyOn": "related",
          "target": "actors.genreIds"
        }
      }
    },
    "Movie": {
      "collection": "movies",
      "fields": {
        "id": {
          "type": "string",
          "primary": true,
          "generated": "uuid"
        },
        "coverSrc": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        },
        "isArchived": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "required": true
        },
        "publisherIds": {
          "type": "string[]"
        },
        "publishers": {
          "type": "Publisher[]",
          "keyOn": "current",
          "required": true
        },
        "actors": {
          "type": "object[]",
          "required": true
        },
        "actors.id": {
          "type": "string"
        },
        "actors.userId": {
          "type": "string"
        },
        "actors.genreIds": {
          "type": "string[]"
        },
        "actors.user": {
          "type": "User",
          "keyOn": "current",
          "source": "actors.userId",
          "required": true
        },
        "actors.genres": {
          "type": "Genre[]",
          "keyOn": "current",
          "source": "actors.genreIds",
          "required": true
        }
      }
    },
    "Publisher": {
      "collection": "publishers",
      "fields": {
        "id": {
          "type": "string",
          "primary": true,
          "generated": "uuid"
        },
        "isArchived": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "movies": {
          "type": "Movie[]",
          "keyOn": "related"
        }
      }
    },
    "User": {
      "collection": "users",
      "fields": {
        "id": {
          "type": "string",
          "primary": true,
          "generated": "uuid"
        },
        "bornAt": {
          "type": "string",
          "format": "date",
          "required": true
        },
        "fullName": {
          "type": "string",
          "required": true
        },
        "isArchived": {
          "type": "boolean"
        },
        "avatarSrc": {
          "type": "string",
          "format": "uri"
        },
        "countryId": {
          "type": "string"
        },
        "country": {
          "type": "Country",
          "keyOn": "current"
        },
        "movies": {
          "type": "Movie[]",
          "keyOn": "related",
          "target": "actors.userId"
        }
      }
    }
  }
}
